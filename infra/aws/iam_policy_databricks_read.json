{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyTheNavPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME",
      "Condition": {
        "StringLike": { "s3:prefix": ["raw/nav/*", "raw/nav"] }
      }
    },
    {
      "Sid": "BucketLocation",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME"
    },
    {
      "Sid": "ReadNavObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/raw/nav/*"
    },
    {
      "Sid": "SelfAssume",
      "Effect": "Allow",
      "Action": ["sts:AssumeRole"],
      "Resource": "arn:aws:iam::REPLACE_WITH_AWS_ACCOUNT_ID:role/mf-nav-databricks-read"
    }
  ]
}
