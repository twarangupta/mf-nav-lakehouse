# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Airflow reads these through Connections and Variables, not from code.

# Databricks (Free Edition workspace URL and a personal access token you create in User Settings > Developer)
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=

# AWS (IAM user with the least-privilege policy in infra/aws/iam_policy_airflow_uploader.json)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
MF_RAW_BUCKET=

# Read-only IAM user for Databricks (policy infra/aws/iam_policy_databricks_read.json).
# Only needed on the laptop to copy the key into the Databricks secret scope `mf_nav`
# (scripts/put_s3_reader_secrets.py). Databricks jobs read it from the secret scope.
S3_READER_ACCESS_KEY_ID=
S3_READER_SECRET_ACCESS_KEY=

# Unity Catalog names (keep stable once created; Prompt 4 depends on them)
MF_CATALOG=mf_nav
MF_RAW_VOLUME=/Volumes/mf_nav/raw/landing

# Optional: Databricks serverless environment version for scripts/run_on_databricks.py (default 4)
DBX_ENV_VERSION=4
